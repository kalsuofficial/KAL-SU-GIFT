# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for HMAC session tokens and AES-256-GCM supplier API key encryption.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# Payment Gateways (Optional - enables automated API verification when configured)
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
MONCASH_MODE="live"
NATCASH_API_KEY=""
NATCASH_MERCHANT_ID=""
PAYMENT_WEBHOOK_SECRET=""

# Notifications (Optional - enables external WhatsApp Cloud API & SMTP email delivery)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
